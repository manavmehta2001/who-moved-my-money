DATABASE_URL=            # Neon pooled connection string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash   # current stable Gemini Flash model (ai.google.dev/gemini-api/docs/models)
NEWSDATA_API_KEY=        # or GNEWS_API_KEY (one is enough; with neither, Google News RSS is used)
GNEWS_API_KEY=
CRON_SECRET=             # any long random string; Vercel sends it as a Bearer token to cron routes
ADMIN_PASSCODE=          # passcode for adding/removing funds and running reports from the UI
NEXT_PUBLIC_APP_URL=     # e.g. https://who-moved-my-money.vercel.app
